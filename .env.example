# AadhaarVoice Environment Configuration

# Application
APP_NAME="AadhaarVoice - Biometric Voice Identity System"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & Cryptography
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="aadhaar-voice-dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 32-byte urlsafe base64 key for Fernet field encryption (default dev key provided)
ENCRYPTION_KEY="dGVzdF9mZXJuZXRfa2V5X2Zvcl9kZXZlbG9wbWVudF8xMjM="

# Database (SQLite default for zero-config demo; PostgreSQL supported)
DATABASE_URL="sqlite:///./data/aadhaar_voice.db"

# Voice Biometrics Parameters
SAMPLE_RATE=16000
N_MFCC=40
VERIFICATION_SIMILARITY_THRESHOLD=0.82
DEEPFAKE_DETECTION_THRESHOLD=0.65
LIVENESS_EXPIRATION_SECONDS=120
